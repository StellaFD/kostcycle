# Copy to .env. Never commit .env or AWS credentials.
DB_USER=kostcycle
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=your-rds-endpoint
DB_PORT=3306
DB_NAME=kostcycle
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
INTERNAL_TOKEN=replace-with-another-random-secret-at-least-32-characters
SEED_DEMO=1
COOKIE_SECURE=0
CATALOG_IMAGE=kostcycle-catalog:local
RESERVATION_IMAGE=kostcycle-reservation:local
APP_BIND=127.0.0.1
APP_PORT=8080
